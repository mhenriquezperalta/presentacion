{
  "name": "presentacion",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de presentación y currículum de Manuel Alejandro Henríquez Peralta",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel /dev:/",
    "dev:css": "tailwindcss -i src/css/app.css -o public/assets/css/app.css --watch=always",
    "dev:server": "vite --open",
    "start": "vite",
    "build": "tailwindcss -i src/css/app.css -o public/assets/css/app.css --minify",
    "postinstall": "pnpm run build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  }
}
